{
  "expo": {
    "name": "YnotMe",
    "slug": "ynotme",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ynotme",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.hackhazards.ynotme",
      "permissions": ["RECORD_AUDIO", "INTERNET"],
      "adaptiveIcon": {
        "backgroundColor": "#090A0F"
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "YnotMe uses your microphone to transcribe conversations and coach you in real time."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "replace-with-eas-project-id"
      }
    }
  }
}
